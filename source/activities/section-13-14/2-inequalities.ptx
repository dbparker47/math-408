<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="inequalities">
  <title>Inequalities</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Prove the following inequalities.
    </p>
  </introduction>

  <exercise>
    <statement>
      <p>
        For all real numbers <m>x</m>, <m>x^2-6x+11 &gt; 0</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Let <m>a_1</m>, <m>a_2</m>, <m>b_1</m>, and <m>b_2</m> be real numbers.  Which of <m>(a_1^2+b_1^2)(b_1^2+b_2^2)</m> and <m>(a_1b_1+a_2b_2)^2</m> is greater than or equal to the other? Hint: Subtract.
      </p>
    </statement>
  </exercise>

</worksheet>