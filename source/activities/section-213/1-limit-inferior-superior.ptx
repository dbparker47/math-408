<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="lim-inf-sup">
  <title>Limits Inferior &amp; Superior</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      For a sequence <m>\{ x_n \}</m>, recall <m>S_n = \{ x_n,x_{n+1}, \ldots \}</m>, <m>a_n =</m> inf<m>(S_n)</m>,  <m>b_n =</m> sup<m>(S_n)</m>, <m>\displaystyle a_n \rightarrow \lim_{n \rightarrow \infty} \inf x_n</m>, and <m>\displaystyle b_n \rightarrow \lim_{n \rightarrow \infty} \sup x_n</m>.
    </p>
  </introduction>

  <exercise>
    <statement>
      <p>
        Find the limit inferior and limit superior of the following sequences.
      </p>
      <ol>
        <li>
          <p>
            <m>\left\{ (-1)^n \left( 1-\frac{1}{n} \right) \right\}</m>
          </p>
        </li>
        <li>
          <p>
            <m>\left\{ 2^{n(-1)^n} \right\}</m>
          </p>
        </li>
        <li>
          <p>
            <m>\left\{ 2^{n(-1)^n}-3^{n(-1)^{n+1}} \right\}</m>
          </p>
        </li>
      </ol>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Prove that for each <m>n \in \mathbb{N}</m>, <m>a_n \leq x_n \leq b_n</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Use the Squeeze Theorem to prove that if <m>\displaystyle \lim_{n \rightarrow \infty} \inf x_n = \lim_{n \rightarrow \infty} \sup x_n</m>, then <m>\{ x_n \}</m> converges.  To what number does <m>\{ x_n \}</m> converge?
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        If <m>\{ x_n \}</m> converges, prove it converges to <m>\displaystyle \lim_{n \rightarrow \infty} \inf x_n</m>. Hint: Use the fact that <m>\{ x_n \}</m> is a Cauchy sequence.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        If <m>\{ x_n \}</m> converges, prove it converges to <m>\displaystyle \lim_{n \rightarrow \infty} \sup x_n</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        If <m>\{ x_n \}</m> converges, what can you say about <m>\displaystyle \lim_{n \rightarrow \infty} \inf x_n</m> and <m>\displaystyle \lim_{n \rightarrow \infty} \sup x_n</m>?
      </p>
    </statement>
  </exercise>

</worksheet>