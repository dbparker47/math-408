<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="extreme-value">
  <title>Extreme Value Theorem</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Let <m>f: [a,b] \rightarrow \mathbb{R}</m> be a continous function.
    </p>
  </introduction>

  <exercise>
    <statement>
      <p>
        Let <m>B</m> be a bounded set of real numbers, with <m>m = \inf(B)</m> and <m>M= \sup(B)</m>.
      </p>
      <ol>
        <li>
          <p>
            Prove that there is a sequence <m>\{ a_n \}</m> with each <m>a_n \in B</m> that converges to <m>m</m>.   Hint:  Look at <m>m+\frac{1}{n}</m>.
          </p>
        </li>
        <li>
          <p>
            Prove that there exists a sequence <m>\{ b_n \}</m> with each <m>b_n \in B</m> that converges to <m>M</m>.  Hint:  Look at <m>M-\frac{1}{n}</m>.
          </p>
        </li>
      </ol>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Assume that <m>f</m> is unbounded from above.
      </p>
      <ol>
        <li>
          <p>
            Try to construct a sequence <m>\{ x_n \}</m> such that <m>\{ f(x_n) \}</m> converges to <m>\infty</m>.  Hint: Try to choose <m>x_n</m> to be large in such a way that <m>f(x_n)</m> keeps getting larger as <m>n</m> gets larger.
          </p>
        </li>
        <li>
          <p>
            Is <m>\{ x_n \}</m> bounded?  Does it converge?  Is there a subsequence that converges?
          </p>
        </li>
        <li>
          <p>
            Let <m>\{ x_{p_n} \}</m> be the convergent subsequence you found in (b).  What does <m>\{ f(x_{p_n}) \}</m> <q>converge</q> to?  What does this tell you?
          </p>
        </li>
        <li>
          <p>
            What do you do if <m>f</m> is unbounded from below?
          </p>
        </li>
      </ol>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Let <m>f: [a,b] \rightarrow \mathbb{R}</m> be a continuous function, and let <m>R</m> be the range of <m>f</m>.
      </p>
      <ol>
        <li>
          <p>
            Suppose <m>s = \sup(R)</m>.  Prove that there is a sequence <m>\{ s_n \}</m> in <m>R</m> that converges to <m>s</m>.
          </p>
        </li>
        <li>
          <p>
            Prove that there is a sequence <m>\{ x_n \} \subseteq [a,b]</m> such that <m>\{ f(x_n) \}</m> converges to <m>s</m>.
          </p>
        </li>
        <li>
          <p>
            Prove there is a subsequence of <m>\{ x_n \}</m> (say <m>\{ x_{p_n} \}</m>) that converges to some <m>x</m>.  What is <m>f(x)</m>?
          </p>
        </li>
        <li>
          <p>
            If <m>\inf(R)</m> exists, prove that <m>\inf(R) \in R</m>.
          </p>
        </li>
      </ol>
    </statement>
  </exercise>

</worksheet>